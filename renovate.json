{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", ":gitSignOff"],
    "abandonmentThreshold": "6 months",
    "assignees": ["atlowChemi"],
    "commitBodyTable": true,
    "configMigration": true,
    "dependencyDashboard": true,
    "dependencyDashboardAutoclose": true,
    "minimumReleaseAge": "5 days",
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "automerge": true
        },
        {
            "matchDepTypes": ["devDependencies"],
            "automerge": true
        },
        {
            "groupName": "vite-plus",
            "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core", "voidzero-dev/setup-vp", "vitest", "@vitest/coverage-v8", "@vitest/browser-playwright"]
        },
        {
            "groupName": "pnpm",
            "matchPackageNames": ["pnpm", "pnpm/setup"]
        },
        {
            "groupName": "iconify-json",
            "matchPackageNames": ["@iconify-json/logos", "@iconify-json/simple-icons"]
        },
        {
            "groupName": "napi",
            "matchPackageNames": ["/^@napi-rs\\//", "/^napi(?:-|$)/"]
        },
        {
            "groupName": "vue and vitepress",
            "matchPackageNames": ["/^@vue\\//", "/^vue(?:-|$)/", "/^vitepress(?:-|$)/"]
        }
    ],
    "postUpdateOptions": ["pnpmDedupe"],
    "rollbackPrs": true,
    "semanticCommitScope": "deps",
    "semanticCommitType": "chore",
    "semanticCommits": "enabled"
}
