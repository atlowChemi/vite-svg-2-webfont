{
    "name": "@atlowchemi/cache-audit",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "test:compat": "node scripts/run.mjs compat",
        "audit": "node scripts/run.mjs audit",
        "audit:negative": "node scripts/run.mjs negative",
        "build": "cargo build -p cache-audit --locked",
        "test": "cargo test -p cache-audit --locked",
        "check": "cargo clippy -p cache-audit --locked -- -D warnings && cargo fmt -p cache-audit -- --check"
    }
}
