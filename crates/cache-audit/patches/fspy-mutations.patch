+++ b/crates/fspy/src/unix/syscall_handler/link.rs
@@ -0,0 +1,25 @@
+use std::io;
+
+use fspy_seccomp_unotify::supervisor::handler::arg::{CStrPtr, Caller, Fd};
+
+use super::SyscallHandler;
+
+impl SyscallHandler {
+    #[cfg(target_arch = "x86_64")]
+    pub(super) fn link(
+        &mut self,
+        caller: Caller,
+        (old_path, new_path): (CStrPtr, CStrPtr),
+    ) -> io::Result<()> {
+        self.linkat(caller, (Fd::cwd(), old_path, Fd::cwd(), new_path))
+    }
+
+    pub(super) fn linkat(
+        &mut self,
+        caller: Caller,
+        (old_dir, old_path, new_dir, new_path): (Fd, CStrPtr, Fd, CStrPtr),
+    ) -> io::Result<()> {
+        self.handle_open(caller, old_dir, old_path, libc::O_RDONLY)?;
+        self.handle_open(caller, new_dir, new_path, libc::O_WRONLY)
+    }
+}
