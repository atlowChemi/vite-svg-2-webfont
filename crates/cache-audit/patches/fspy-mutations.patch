index 0000000000000000000000000000000000000000..8566af0a0789036af2c76e485b97f776aed67bd4
--- /dev/null
+++ b/crates/fspy_preload_unix/src/interceptions/link.rs
@@ -0,0 +1,46 @@
+use fspy_shared::ipc::AccessMode;
+use libc::{c_char, c_int};
+
+use crate::{
+    client::{convert::PathAt, handle_open},
+    macros::intercept,
+};
+
+// Follow fspy's existing attempted-access semantics: report before forwarding.
+pub(super) unsafe fn report_linkat(
+    old_dir: c_int,
+    old_path: *const c_char,
+    new_dir: c_int,
+    new_path: *const c_char,
+) {
+    // SAFETY: valid pathname/descriptor arguments from the intercepted call.
+    unsafe {
+        handle_open(PathAt::borrow_raw(old_dir, old_path), AccessMode::Read);
+        handle_open(PathAt::borrow_raw(new_dir, new_path), AccessMode::Write);
+    }
+}
+
+intercept!(link: unsafe extern "C" fn(*const c_char, *const c_char) -> c_int);
+unsafe extern "C" fn link(old_path: *const c_char, new_path: *const c_char) -> c_int {
+    // SAFETY: forward the caller's valid arguments unchanged.
+    unsafe {
+        report_linkat(libc::AT_FDCWD, old_path, libc::AT_FDCWD, new_path);
+        link::original()(old_path, new_path)
+    }
+}
+
+intercept!(linkat: unsafe extern "C" fn(c_int, *const c_char, c_int, *const c_char, c_int) -> c_int);
+unsafe extern "C" fn linkat(
+    old_dir: c_int,
+    old_path: *const c_char,
+    new_dir: c_int,
+    new_path: *const c_char,
+    flags: c_int,
+) -> c_int {
+    // SAFETY: forward the caller's valid arguments unchanged. PathAt also resolves
+    // an empty source pathname through its fd (Linux AT_EMPTY_PATH).
+    unsafe {
+        report_linkat(old_dir, old_path, new_dir, new_path);
+        linkat::original()(old_dir, old_path, new_dir, new_path, flags)
+    }
+}
