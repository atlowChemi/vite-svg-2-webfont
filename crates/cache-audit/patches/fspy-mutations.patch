index 0000000000000000000000000000000000000000..f1a09516535296e4625de301c79d8e383ae8b111
--- /dev/null
+++ b/crates/fspy_preload_unix/src/interceptions/mutation.rs
@@ -0,0 +1,97 @@
+use crate::{
+    client::{convert::PathAt, handle_open},
+    macros::intercept,
+};
+use fspy_shared::ipc::AccessMode;
+use libc::{c_char, c_int, c_uint};
+
+pub(super) unsafe fn report_rename(
+    old_fd: c_int,
+    old: *const c_char,
+    new_fd: c_int,
+    new: *const c_char,
+    exchange: bool,
+) {
+    // SAFETY: borrowed path and fd arguments from the intercepted function.
+    unsafe {
+        handle_open(PathAt::borrow_raw(old_fd, old), AccessMode::ReadWrite);
+        handle_open(
+            PathAt::borrow_raw(new_fd, new),
+            if exchange { AccessMode::ReadWrite } else { AccessMode::Write },
+        );
+    }
+}
+
+pub(super) unsafe fn report_write(fd: c_int, path: *const c_char) {
+    // SAFETY: borrowed path and fd arguments from the intercepted function.
+    unsafe {
+        handle_open(PathAt::borrow_raw(fd, path), AccessMode::Write);
+    }
+}
+
+intercept!(rename: unsafe extern "C" fn(*const c_char, *const c_char) -> c_int);
+unsafe extern "C" fn rename(old: *const c_char, new: *const c_char) -> c_int {
+    // SAFETY: report and forward the caller's arguments unchanged.
+    unsafe {
+        report_rename(libc::AT_FDCWD, old, libc::AT_FDCWD, new, false);
+        rename::original()(old, new)
+    }
+}
+
+intercept!(renameat: unsafe extern "C" fn(c_int, *const c_char, c_int, *const c_char) -> c_int);
+unsafe extern "C" fn renameat(
+    old_fd: c_int,
+    old: *const c_char,
+    new_fd: c_int,
+    new: *const c_char,
+) -> c_int {
+    // SAFETY: report and forward the caller's arguments unchanged.
+    unsafe {
+        report_rename(old_fd, old, new_fd, new, false);
+        renameat::original()(old_fd, old, new_fd, new)
+    }
+}
+
+#[cfg(target_os = "linux")]
+intercept!(renameat2: unsafe extern "C" fn(c_int, *const c_char, c_int, *const c_char, c_uint) -> c_int);
+#[cfg(target_os = "linux")]
+unsafe extern "C" fn renameat2(
+    old_fd: c_int,
+    old: *const c_char,
+    new_fd: c_int,
+    new: *const c_char,
+    flags: c_uint,
+) -> c_int {
+    // SAFETY: report and forward the caller's arguments unchanged.
+    unsafe {
+        report_rename(old_fd, old, new_fd, new, flags & libc::RENAME_EXCHANGE != 0);
+        renameat2::original()(old_fd, old, new_fd, new, flags)
+    }
+}
+
+intercept!(unlink: unsafe extern "C" fn(*const c_char) -> c_int);
+unsafe extern "C" fn unlink(path: *const c_char) -> c_int {
+    // SAFETY: report and forward the caller's arguments unchanged.
+    unsafe {
+        report_write(libc::AT_FDCWD, path);
+        unlink::original()(path)
+    }
+}
+
+intercept!(unlinkat: unsafe extern "C" fn(c_int, *const c_char, c_int) -> c_int);
+unsafe extern "C" fn unlinkat(fd: c_int, path: *const c_char, flags: c_int) -> c_int {
+    // SAFETY: report and forward the caller's arguments unchanged.
+    unsafe {
+        report_write(fd, path);
+        unlinkat::original()(fd, path, flags)
+    }
+}
+
+intercept!(rmdir: unsafe extern "C" fn(*const c_char) -> c_int);
+unsafe extern "C" fn rmdir(path: *const c_char) -> c_int {
+    // SAFETY: report and forward the caller's arguments unchanged.
+    unsafe {
+        report_write(libc::AT_FDCWD, path);
+        rmdir::original()(path)
+    }
+}
