index 0000000000000000000000000000000000000000..6d04be2f2b99ca45448cc506f1f74442ea24a5bd
--- /dev/null
+++ b/crates/fspy/src/unix/syscall_handler/mutation.rs
@@ -0,0 +1,45 @@
+use super::SyscallHandler;
+use fspy_seccomp_unotify::supervisor::handler::arg::{CStrPtr, Caller, Fd};
+use std::{ffi::c_uint, io};
+
+impl SyscallHandler {
+    pub(super) fn renameat2(
+        &mut self,
+        caller: Caller,
+        (old_fd, old, new_fd, new, flags): (Fd, CStrPtr, Fd, CStrPtr, c_uint),
+    ) -> io::Result<()> {
+        self.handle_open(caller, old_fd, old, libc::O_RDWR)?;
+        self.handle_open(
+            caller,
+            new_fd,
+            new,
+            if flags & libc::RENAME_EXCHANGE != 0 { libc::O_RDWR } else { libc::O_WRONLY },
+        )
+    }
+    pub(super) fn renameat(
+        &mut self,
+        caller: Caller,
+        (old_fd, old, new_fd, new): (Fd, CStrPtr, Fd, CStrPtr),
+    ) -> io::Result<()> {
+        self.renameat2(caller, (old_fd, old, new_fd, new, 0))
+    }
+    #[cfg(target_arch = "x86_64")]
+    pub(super) fn rename(
+        &mut self,
+        caller: Caller,
+        (old, new): (CStrPtr, CStrPtr),
+    ) -> io::Result<()> {
+        self.renameat(caller, (Fd::cwd(), old, Fd::cwd(), new))
+    }
+    pub(super) fn unlinkat(&mut self, caller: Caller, (fd, path): (Fd, CStrPtr)) -> io::Result<()> {
+        self.handle_open(caller, fd, path, libc::O_WRONLY)
+    }
+    #[cfg(target_arch = "x86_64")]
+    pub(super) fn unlink(&mut self, caller: Caller, (path,): (CStrPtr,)) -> io::Result<()> {
+        self.unlinkat(caller, (Fd::cwd(), path))
+    }
+    #[cfg(target_arch = "x86_64")]
+    pub(super) fn rmdir(&mut self, caller: Caller, (path,): (CStrPtr,)) -> io::Result<()> {
+        self.unlinkat(caller, (Fd::cwd(), path))
+    }
+}
diff --git a/crates/fspy_preload_unix/src/interceptions/link.rs b/crates/fspy_preload_unix/src/interceptions/link.rs
