{
    "name": "@atlowchemi/vite-svg-webfont-mono",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
    "engines": {
        "node": "^22 || ^24 || >=26"
    },
    "scripts": {
        "prepare": "vp config",
        "next:pipeline": "node scripts/next-pipeline.mjs",
        "next:verify": "node scripts/verify-pipelines.mjs",
        "next:fmt:rust": "cargo fmt --all -- --check",
        "next:engine:check": "pnpm --dir crates/webfont-generator run next:check",
        "next:engine:test": "pnpm --dir crates/webfont-generator run next:test",
        "next:engine:features": "pnpm --dir crates/webfont-generator run next:test:features",
        "next:native": "pnpm --dir packages/webfont-generator run next:build",
        "next:adapter:check": "pnpm --dir packages/webfont-generator run next:check",
        "next:adapter:test": "pnpm --dir packages/webfont-generator run next:test",
        "next:wasm": "pnpm --dir packages/webfont-browser run next:build",
        "next:browser:pack": "pnpm --dir packages/webfont-browser run next:pack",
        "next:browser:check": "pnpm --dir packages/webfont-browser run next:check",
        "next:browser:test": "pnpm --dir packages/webfont-browser run next:test",
        "next:plugin:pack": "pnpm --dir packages/vite-svg-2-webfont run next:pack",
        "next:plugin:test": "pnpm --dir packages/vite-svg-2-webfont run next:test",
        "next:docs:svg": "node scripts/next-pipeline.mjs --require-fingerprint && pnpm --dir packages/docs run next:optimize-svg",
        "next:docs:social": "pnpm --dir packages/docs run next:social-card",
        "next:docs": "pnpm --dir packages/docs run next:build",
        "next:example": "pnpm --dir packages/example run next:build",
        "next:test:js": "vp test --run",
        "next:coverage": "vp test --run --coverage --project='!*-browser*'"
    },
    "devDependencies": {
        "@atlowchemi/webfont-generator": "workspace:*",
        "@codecov/rollup-plugin": "^2.0.1",
        "@commitlint/cli": "^21.0.0",
        "@commitlint/config-conventional": "^21.0.0",
        "@iconify-json/logos": "^1.2.11",
        "@iconify-json/simple-icons": "^1.2.85",
        "@napi-rs/cli": "^3.5.1",
        "@types/node": "^24.0.7",
        "@types/opentype.js": "^1.3.9",
        "@types/vusion__webfonts-generator": "^0.8.6",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@vusion/webfonts-generator": "^0.8.0",
        "opentype.js": "^2.0.0",
        "oxc-minify": "catalog:",
        "playwright": "^1.55.0",
        "sass": "^1.98.0",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "yaml": "^2.9.1"
    }
}
