{
    "name": "@atlowchemi/vite-svg-webfont-mono",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
    "engines": {
        "node": "^22 || ^24 || >=26"
    },
    "scripts": {
        "pnpm:devPreinstall": "node crates/cache-audit/scripts/prepare.mjs",
        "prepare": "git config core.hooksPath .githooks",
        "check": "oxfmt --check && oxlint --type-aware --type-check",
        "fmt": "oxfmt",
        "bench:vitest": "vitest bench --run --reporter=verbose --hideSkippedTests",
        "test:compat": "vitest --run --project=compat",
        "coverage:scripts": "vitest --run --project=scripts --coverage --coverage.autoAttachSubprocess --coverage.include='scripts/**/*.{ts,mjs}' --coverage.reportsDirectory=coverage/scripts",
        "engine:bench": "pnpm --dir crates/webfont-generator run bench",
        "engine:coverage": "pnpm --dir crates/webfont-generator run test:coverage",
        "engine:coverage:cli": "pnpm --dir crates/webfont-generator run test:coverage:cli",
        "engine:doctests": "pnpm --dir crates/webfont-generator run test:doctests",
        "engine:color-proof": "pnpm --dir crates/webfont-generator run test:color-proof",
        "adapter:browser": "pnpm --dir packages/webfont-generator run test:browser",
        "adapter:color-proof": "pnpm --dir packages/webfont-generator run test:color-proof",
        "adapter:coverage": "pnpm --dir packages/webfont-generator run test:coverage",
        "adapter:coverage:native": "pnpm --dir packages/webfont-generator run test:coverage:native",
        "adapter:binding:regenerate": "pnpm --dir packages/webfont-generator run binding:regenerate",
        "adapter:bench": "pnpm --dir packages/webfont-generator run bench",
        "native:release": "pnpm --dir packages/webfont-generator run build:release",
        "browser:tgz": "pnpm --dir packages/webfont-browser run pack:tgz",
        "browser:coverage": "pnpm --dir packages/webfont-browser run test:coverage",
        "browser:publish": "pnpm --dir packages/webfont-browser run publish",
        "plugin:dev": "pnpm --dir packages/vite-svg-2-webfont run dev",
        "plugin:tgz": "pnpm --dir packages/vite-svg-2-webfont run pack:tgz",
        "plugin:browser": "pnpm --dir packages/vite-svg-2-webfont run test:browser",
        "plugin:fixtures": "pnpm --dir packages/vite-svg-2-webfont run test:fixtures:refresh",
        "plugin:publish": "pnpm --dir packages/vite-svg-2-webfont run publish",
        "example:dev": "pnpm --dir packages/example run dev",
        "example:preview": "pnpm --dir packages/example run preview",
        "docs:dev": "pnpm --dir packages/docs run dev",
        "docs:preview": "pnpm --dir packages/docs run preview",
        "fmt:rust": "cargo fmt --all -- --check",
        "engine:check": "pnpm --dir crates/webfont-generator run check",
        "engine:test": "pnpm --dir crates/webfont-generator run test",
        "engine:features": "pnpm --dir crates/webfont-generator run test:features",
        "native": "pnpm --dir packages/webfont-generator run build",
        "adapter:check": "pnpm --dir packages/webfont-generator run check",
        "adapter:test": "pnpm --dir packages/webfont-generator run test",
        "wasm": "pnpm --dir packages/webfont-browser run build",
        "browser:pack": "pnpm --dir packages/webfont-browser run pack",
        "browser:check": "pnpm --dir packages/webfont-browser run check",
        "browser:test": "pnpm --dir packages/webfont-browser run test",
        "plugin:pack": "pnpm --dir packages/vite-svg-2-webfont run pack",
        "plugin:test": "pnpm --dir packages/vite-svg-2-webfont run test",
        "docs:svg": "pnpm --dir packages/docs run optimize-svg",
        "docs:social": "pnpm --dir packages/docs run social-card",
        "docs": "pnpm --dir packages/docs run build",
        "example": "pnpm --dir packages/example run build",
        "test:js": "vitest --run",
        "coverage": "vitest --run --coverage --project='!*-browser*'"
    },
    "devDependencies": {
        "@atlowchemi/webfont-generator": "workspace:*",
        "@codecov/rollup-plugin": "^2.0.1",
        "@commitlint/cli": "^21.0.0",
        "@commitlint/config-conventional": "^21.0.0",
        "@iconify-json/logos": "^1.2.11",
        "@iconify-json/simple-icons": "^1.2.85",
        "@napi-rs/cli": "^3.5.1",
        "@types/node": "^24.0.7",
        "@types/opentype.js": "^1.3.9",
        "@types/vusion__webfonts-generator": "^0.8.6",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@vusion/webfonts-generator": "^0.8.0",
        "eslint-plugin-unicorn": "^79.0.0",
        "opentype.js": "^2.0.0",
        "lint-staged": "17.6.0",
        "oxfmt": "0.73.0",
        "oxlint": "1.88.0",
        "oxlint-tsgolint": "7.0.2004",
        "oxc-minify": "catalog:",
        "playwright": "^1.55.0",
        "sass": "^1.98.0",
        "typescript": "catalog:",
        "tsdown": "0.23.5",
        "vite": "catalog:",
        "vitest": "catalog:",
        "yaml": "^2.9.1"
    }
}
