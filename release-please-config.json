{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "include-commit-authors": true,
    "plugins": [{ "type": "linked-versions", "groupName": "webfont-generator", "components": ["webfont-generator", "webfont-engine"], "merge": false }, "node-workspace"],
    "packages": {
        "crates/webfont-generator": {
            "release-type": "rust",
            "component": "webfont-engine",
            "bump-minor-pre-major": true
        },
        "packages/vite-svg-2-webfont": {
            "release-type": "node",
            "component": "vite-svg-2-webfont"
        },
        "packages/webfont-generator": {
            "release-type": "node",
            "component": "webfont-generator",
            "bump-minor-pre-major": true,
            "extra-files": [
                {
                    "type": "toml",
                    "path": "Cargo.toml",
                    "jsonpath": "$.package.version"
                },
                {
                    "type": "toml",
                    "path": "Cargo.toml",
                    "jsonpath": "$.dependencies['webfont-generator'].version"
                }
            ]
        }
    }
}
