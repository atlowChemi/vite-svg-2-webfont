{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "declaration": false,
        "isolatedDeclarations": false,
        "lib": ["esnext", "dom", "dom.iterable"],
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "paths": {
            "vite-svg-2-webfont": ["../vite-svg-2-webfont/src/index.ts"],
            "@atlowchemi/webfont-browser-generator": ["../webfont-browser/src/index.ts"]
        },
        "types": ["vite-plus/client"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "examples/**/*.ts", "scripts/**/*.ts", "env.d.ts", "vite.config.ts"],
    "exclude": ["node_modules", ".cache", "dist"]
}
