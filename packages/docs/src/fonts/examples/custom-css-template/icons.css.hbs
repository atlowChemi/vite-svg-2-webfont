@font-face {
	font-family: "{{fontName}}";
	font-display: block;
	src: {{{src}}};
}

{{baseSelector}} {
	display: inline-block;
	line-height: 1;
}

{{baseSelector}}:before {
	font-family: {{fontName}} !important;
	font-style: normal;
	font-weight: normal !important;
	vertical-align: top;
}

/* Utilities this template adds to the generated CSS. */
{{baseSelector}}--lg {
	font-size: 2em;
}

{{baseSelector}}--spin {
	animation: {{fontName}}-spin 1s linear infinite;
}

@keyframes {{fontName}}-spin {
	to {
		transform: rotate(360deg);
	}
}

{{#each codepoints}}
.{{../classPrefix}}{{@key}}:before {
	content: "\\{{this}}";
}
{{/each}}
