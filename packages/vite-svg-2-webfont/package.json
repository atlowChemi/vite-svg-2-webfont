{
    "name": "vite-svg-2-webfont",
    "version": "8.6.0",
    "description": "A vite plugin which generates a webfont out of svg icons",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./virtuals": {
            "types": "./dist/virtuals.d.ts"
        },
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": "^22 || ^24 || >=26"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/atlowChemi/vite-svg-2-webfont",
        "directory": "packages/vite-svg-2-webfont"
    },
    "keywords": [
        "vite",
        "vite-plugin",
        "svg-font",
        "webfont",
        "webfont-loader"
    ],
    "author": "Chemi Atlow",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/atlowChemi/vite-svg-2-webfont/issues"
    },
    "homepage": "https://fonte.atlow.dev/",
    "peerDependencies": {
        "vite": "^6.0.0  || ^7.0.0 || ^8.0.0"
    },
    "dependencies": {
        "@atlowchemi/webfont-generator": "workspace:^"
    }
}
