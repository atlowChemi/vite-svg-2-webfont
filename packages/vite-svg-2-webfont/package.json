{
    "name": "vite-svg-2-webfont",
    "version": "8.6.0",
    "description": "A vite plugin which generates a webfont out of svg icons",
    "type": "module",
    "scripts": {
        "next:dev": "vp pack --watch",
        "next:pack:tgz": "pnpm pack",
        "next:test:browser": "vp test --run --root ../.. --project=vite-svg-webfont-browser",
        "next:test:fixtures:refresh": "node ./scripts/refresh-font-fixtures.ts",
        "next:publish": "pnpm run next:pack && pnpm run next:pack:tgz && vp exec -c \"pnpm stage publish vite-svg-2-webfont-*.tgz --no-git-checks\"",
        "next:pack": "vp pack",
        "next:test": "vp test --run"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./virtuals": {
            "types": "./dist/virtuals.d.ts"
        },
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": "^22 || ^24 || >=26"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/atlowChemi/vite-svg-2-webfont",
        "directory": "packages/vite-svg-2-webfont"
    },
    "keywords": [
        "vite",
        "vite-plugin",
        "svg-font",
        "webfont",
        "webfont-loader"
    ],
    "author": "Chemi Atlow",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/chemiAtlow/vite-svg-2-webfont/issues"
    },
    "homepage": "https://atlowChemi.github.io/vite-svg-2-webfont/",
    "peerDependencies": {
        "vite": "^6.0.0  || ^7.0.0 || ^8.0.0"
    },
    "dependencies": {
        "@atlowchemi/webfont-generator": "workspace:^"
    }
}
